{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remember-me.app/spec/v0/entry.schema.json",
  "title": "Remember Me — entries/<id>.json",
  "description": "Un souvenir. Immuable une fois publié : une correction = nouvelle entrée qui remplace l'ancienne (supersedes), une suppression = entrée vide de type tombstone.",
  "type": "object",
  "required": ["id", "type", "authorId", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "manifest.schema.json#/$defs/uuid" },
    "type": { "$ref": "#/$defs/entryType" },
    "authorId": { "$ref": "manifest.schema.json#/$defs/uuid" },
    "createdAt": { "$ref": "manifest.schema.json#/$defs/timestamp" },
    "title": { "type": "string", "maxLength": 200 },
    "text": {
      "type": "string",
      "maxLength": 50000,
      "description": "Texte brut, sauts de ligne autorisés. Pas de HTML (sécurité du viewer)."
    },
    "date": { "$ref": "#/$defs/fuzzyDate" },
    "place": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "people": {
      "type": "array",
      "description": "Personnes présentes dans le souvenir, en texte libre.",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 50 }
    },
    "media": {
      "type": "array",
      "items": { "$ref": "#/$defs/media" }
    },
    "replyTo": {
      "$ref": "manifest.schema.json#/$defs/uuid",
      "description": "Entrée que celle-ci complète (un proche ajoute sa version d'un souvenir)."
    },
    "supersedes": {
      "$ref": "manifest.schema.json#/$defs/uuid",
      "description": "Entrée que celle-ci remplace (correction) ou supprime (tombstone). Réservé à l'auteur d'origine ou au créateur."
    },
    "prompt": {
      "type": "string",
      "maxLength": 300,
      "description": "Question guidée ayant inspiré l'entrée (phase 3), ex. « Quel était ton premier métier ? »."
    },
    "signature": {
      "$ref": "#/$defs/signature",
      "description": "Signature de l'auteur (v2, optionnelle en v0)."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "text" } } },
      "then": { "required": ["text"], "properties": { "text": { "minLength": 1 } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["photo", "audio", "video"] } } },
      "then": { "required": ["media"], "properties": { "media": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "type": { "const": "tombstone" } } },
      "then": {
        "required": ["supersedes"],
        "not": {
          "anyOf": [
            { "required": ["title"] }, { "required": ["text"] }, { "required": ["date"] },
            { "required": ["place"] }, { "required": ["people"] }, { "required": ["tags"] },
            { "required": ["media"] }, { "required": ["replyTo"] }, { "required": ["prompt"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "entryType": {
      "enum": ["text", "photo", "audio", "video", "tombstone"],
      "description": "Nature principale de l'entrée. tombstone = entrée vide qui supprime celle visée par supersedes."
    },
    "partialDate": {
      "type": "string",
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "description": "Date ISO tronquée : AAAA, AAAA-MM ou AAAA-MM-JJ. Triable telle quelle comme chaîne."
    },
    "fuzzyDate": {
      "type": "object",
      "description": "Date de souvenir, souvent approximative. Sert au tri chronologique via value.",
      "additionalProperties": false,
      "anyOf": [{ "required": ["value"] }, { "required": ["label"] }],
      "properties": {
        "value": { "$ref": "#/$defs/partialDate" },
        "approximate": { "type": "boolean", "default": false },
        "label": {
          "type": "string",
          "maxLength": 100,
          "description": "Formulation humaine affichée telle quelle (« l'été de mes 20 ans »)."
        }
      }
    },
    "mediaPath": {
      "type": "string",
      "pattern": "^media/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.[a-z0-9]{2,5}$",
      "description": "Chemin dans l'archive : media/<uuid>.<ext>. Pas de nom d'origine (vie privée, collisions)."
    },
    "media": {
      "type": "object",
      "required": ["path", "mimeType", "size", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/mediaPath" },
        "mimeType": {
          "enum": ["image/jpeg", "image/webp", "image/png", "audio/webm", "audio/ogg", "audio/mp4", "video/mp4", "video/webm"]
        },
        "size": { "type": "integer", "minimum": 1, "description": "Octets. Plafond selon le type, voir allOf." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Intégrité et dédoublonnage à la fusion." },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "caption": { "type": "string", "maxLength": 500 },
        "transcript": { "type": "string", "maxLength": 50000, "description": "Transcription d'un audio/vidéo (accessibilité)." }
      },
      "allOf": [
        {
          "if": { "properties": { "mimeType": { "pattern": "^image/" } } },
          "then": {
            "required": ["width", "height"],
            "properties": { "size": { "maximum": 3145728 }, "width": { "maximum": 4096 }, "height": { "maximum": 4096 } },
            "not": { "required": ["durationSec"] }
          }
        },
        {
          "if": { "properties": { "mimeType": { "pattern": "^audio/" } } },
          "then": {
            "required": ["durationSec"],
            "properties": { "size": { "maximum": 10485760 }, "durationSec": { "maximum": 1800 } }
          }
        },
        {
          "if": { "properties": { "mimeType": { "pattern": "^video/" } } },
          "then": {
            "required": ["width", "height", "durationSec"],
            "properties": {
              "size": { "maximum": 20971520 },
              "durationSec": { "maximum": 180 },
              "width": { "maximum": 1920 },
              "height": { "maximum": 1920 }
            }
          }
        }
      ]
    },
    "signature": {
      "type": "object",
      "required": ["alg", "keyId", "value"],
      "additionalProperties": false,
      "description": "Signature de l'entrée par son auteur. Données signées : l'entrée sans le champ signature, canonisée en JCS (RFC 8785). Les médias sont couverts via leur sha256.",
      "properties": {
        "alg": { "const": "ES256", "description": "ECDSA P-256 + SHA-256 (WebCrypto, supporté partout)." },
        "keyId": { "type": "string", "pattern": "^[0-9a-f]{16}$", "description": "Identifiant de la clé publique de l'auteur (cf. manifest authors[].publicKey.keyId)." },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$", "description": "Signature brute r||s (64 octets) en base64url sans padding." }
      }
    }
  }
}
